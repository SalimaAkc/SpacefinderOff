<Page x:Class="SpacefinderOff.Views.ForgotPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ForgotPassword">

    <Grid Background="#F8F9FA">
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="15"
                Padding="40"
                MinWidth="400">

            <StackPanel>
                <TextBlock Text="📧"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Reset your password" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Enter your school email and we’ll send you a reset link." 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="#7F8C8D"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>

                <TextBlock Text="School Email" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,5"/>
                <TextBox Name="EmailTextBox" 
                         Padding="15,12" 
                         FontSize="14"
                         Margin="0,0,0,20"
                         BorderBrush="#BDC3C7"
                         BorderThickness="2"/>

                <Button Content="Send me the link"
                        Name="SendLinkButton"
                        Padding="0,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,0,0,15"
                        Background="#007ACC"
                        Foreground="White"
                        BorderBrush="#007ACC"
                        Click="SendLinkButton_Click"/>

                <Button Content="Back to login"
                        Name="BackToLoginButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#007ACC"
                        FontWeight="Bold"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Click="BackToLoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
