<Page x:Class="SpacefinderOff.Views.AdminDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Admin Dashboard">

    <Grid Background="#F8F9FA">
        <Border Background="#1F2937" Height="70" VerticalAlignment="Top">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🛡️ Admin Dashboard" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <Button Name="BackToProfileButton" 
                            Content="← Back to Profile" 
                            Background="#374151" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,8" 
                            Margin="0,0,15,0"
                            FontSize="12"
                            Cursor="Hand"
                            Click="BackToProfileButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4B5563"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Name="LogoutButton" 
                            Content="Logout" 
                            Background="#DC2626" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,8" 
                            FontSize="12"
                            Cursor="Hand"
                            Click="LogoutButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B91C1C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,70,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Margin="20" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Statistics" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>

                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Total Users" FontSize="12" Foreground="#1E40AF" FontWeight="SemiBold"/>
                            <TextBlock Name="TotalUsersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#1E40AF"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Active Bookings" FontSize="12" Foreground="#15803D" FontWeight="SemiBold"/>
                            <TextBlock Name="ActiveBookingsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#15803D"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF7FF" BorderBrush="#F3E8FF" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="New This Week" FontSize="12" Foreground="#7C3AED" FontWeight="SemiBold"/>
                            <TextBlock Name="NewUsersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#7C3AED"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="Bold" Foreground="#1F2937" Margin="0,30,0,15"/>

                    <Button Name="CreateUserButton" 
                            Content="➕ Create New User" 
                            Background="#10B981" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,10" 
                            Width="250"
                            Margin="0,0,0,10"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="CreateUserButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#059669"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Name="RefreshDataButton" 
                            Content="🔄 Refresh Data" 
                            Background="#3B82F6" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,10" 
                            Width="250"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="RefreshDataButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" Margin="0,20,20,20" CornerRadius="10" Padding="30">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="User Management" FontSize="24" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Name="SearchBox" 
                                     Width="200" 
                                     Padding="10" 
                                     BorderBrush="#D1D5DB" 
                                     Background="White"
                                     FontSize="12"
                                     TextChanged="SearchBox_TextChanged"/>
                            <Button Content="🔍" 
                                    Background="#6B7280" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="10" 
                                    Margin="5,0,0,0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Name="UsersDataGrid" 
                              Height="400"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="White"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              SelectionMode="Single"
                              SelectionChanged="UsersDataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Registration Date" Binding="{Binding RegistrationDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" 
                                                    Background="#F59E0B" 
                                                    Foreground="White" 
                                                    BorderThickness="0" 
                                                    Padding="8,4" 
                                                    Margin="2"
                                                    FontSize="10"
                                                    Cursor="Hand"
                                                    Click="EditUserButton_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="Reset PWD" 
                                                    Background="#8B5CF6" 
                                                    Foreground="White" 
                                                    BorderThickness="0" 
                                                    Padding="8,4" 
                                                    Margin="2"
                                                    FontSize="10"
                                                    Cursor="Hand"
                                                    Click="ResetPasswordButton_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="Delete" 
                                                    Background="#EF4444" 
                                                    Foreground="White" 
                                                    BorderThickness="0" 
                                                    Padding="8,4" 
                                                    Margin="2"
                                                    FontSize="10"
                                                    Cursor="Hand"
                                                    Click="DeleteUserButton_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                        <StackPanel Name="UserDetailsPanel" Visibility="Collapsed">
                            <TextBlock Text="Selected User Details" FontSize="16" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="User Information" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,10"/>
                                    <TextBlock Name="SelectedUserName" Text="Name: -" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                                    <TextBlock Name="SelectedUserEmail" Text="Email: -" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                                    <TextBlock Name="SelectedUserPhone" Text="Phone: -" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                                    <TextBlock Name="SelectedUserRole" Text="Role: -" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Account Status" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,10"/>
                                    <TextBlock Name="SelectedUserRegistration" Text="Registered: -" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                                    <TextBlock Name="SelectedUserBookings" Text="Total Bookings: -" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                                    <TextBlock Name="SelectedUserLastLogin" Text="Last Login: -" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>