<Window x:Class="SpacefinderOff.Views.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New User" Height="400" Width="400">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Full Name:" Grid.Row="0" Margin="5"/>
        <TextBox x:Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Email:" Grid.Row="1" Margin="5"/>
        <TextBox x:Name="EmailTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Phone:" Grid.Row="2" Margin="5"/>
        <TextBox x:Name="PhoneTextBox" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Password:" Grid.Row="3" Margin="5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Confirm Password:" Grid.Row="4" Margin="5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Role:" Grid.Row="5" Margin="5"/>
        <ComboBox x:Name="RoleComboBox" Grid.Row="5" Grid.Column="1" Margin="5"
                  SelectedIndex="1">
            <ComboBoxItem Content="admin" Tag="admin"/>
            <ComboBoxItem Content="user" Tag="user"/>
            <ComboBoxItem Content="owner" Tag="owner"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Margin="5" Padding="10 5" 
                    Click="CancelButton_Click"/>
            <Button x:Name="CreateButton" Content="Create User" Margin="5" Padding="10 5"
                    Click="CreateButton_Click" Background="#FF0E7C0E" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>