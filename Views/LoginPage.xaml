<Page x:Class="SpacefinderOff.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login">

    <Grid Background="#F8F9FA">
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="15"
                Padding="40"
                MinWidth="400">

            <StackPanel>
                <TextBlock Text="🚀" 
                          FontSize="48" 
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="Welcome to Spacefinder" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center"
                          Foreground="#2C3E50"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Sign in to your account" 
                          FontSize="14" 
                          HorizontalAlignment="Center"
                          Foreground="#7F8C8D"
                          Margin="0,0,0,30"/>

                <StackPanel>
                    <TextBlock Text="Email" 
                              FontWeight="SemiBold" 
                              Margin="0,0,0,5"/>
                    <TextBox Name="EmailTextBox" 
                            Padding="15,12" 
                            FontSize="14"
                            Margin="0,0,0,15"
                            BorderBrush="#BDC3C7"
                            BorderThickness="2"/>

                    <TextBlock Text="Password" 
                              FontWeight="SemiBold" 
                              Margin="0,0,0,5"/>
                    <PasswordBox Name="PasswordBox" 
                                Padding="15,12" 
                                FontSize="14"
                                Margin="0,0,0,20"
                                BorderBrush="#BDC3C7"
                                BorderThickness="2"/>

                    <CheckBox Name="RememberMeCheckBox" 
                             Content="Remember me" 
                             Margin="0,0,0,20"/>

                    <Button Content="Sign In"
                            Name="SignInButton"
                           Padding="0,15"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"
                           Background="#007ACC"
                           Foreground="White"
                           BorderBrush="#007ACC"
                           Click="SignInButton_Click"/>

                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0">
                        <TextBlock Text="Don't have an account? " 
                                  Foreground="#7F8C8D"/>
                        <Button Content="Sign up here" 
                                Name="SignUpButton"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="#007ACC"
                               Cursor="Hand"
                               Click="SignUpButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
