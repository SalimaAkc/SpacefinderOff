<Page x:Class="SpacefinderOff.Views.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BookingPage">
	<DockPanel>
	<Grid Background="#F8F9FA">
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Width="400">

			<TextBlock Text="Spacefinder Booking"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

			<Button Content="Campus Kruidtuin"
                    Margin="0,10"
                    Padding="20"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CampusKruidtuin_Click"/>

			<Button Content="Campus De Vest"
                    Margin="0,10"
                    Padding="20"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CampusDeVest_Click"/>

			<Button Content="Campus De Ham"
                    Margin="0,10"
                    Padding="20"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CampusDeHam_Click"/>

			<Button Content="Campus Lucas Faydherbe"
                    Margin="0,10"
                    Padding="20"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CampusLucasFaydherbe_Click"/>
		</StackPanel>
		<Frame Name="MainFrame" NavigationUIVisibility="Hidden"/>
	</Grid>
		</DockPanel>
	
</Page>
