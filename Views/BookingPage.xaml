<Page x:Class="SpacefinderOff.Views.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="BookingPage">

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#F8F9FA" Margin="20">
            <Button Name="ProfileButton"
                    Content="My Profile"
                    HorizontalAlignment="Right"
                    Padding="8,4"
                    Margin="0,10,0,0"
                    FontSize="14"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="#007ACC"
                    BorderThickness="1"
                    Cursor="Hand" 
                    Click="ProfileButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Width="600">

                <ComboBox Name="CampusComboBox"
                          Margin="0,10"
                          Padding="10"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select Campus" Foreground="Gray"/>
                    <ComboBoxItem Content="Campus Kruidtuin"/>
                    <ComboBoxItem Content="Campus De Vest"/>
                    <ComboBoxItem Content="Campus De Ham"/>
                    <ComboBoxItem Content="Campus Lucas Faydherbe"/>
                </ComboBox>

                <ComboBox Name="DayComboBox"
                          Margin="0,10"
                          Padding="10"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select Day" Foreground="Gray"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="13"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="17"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="19"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="21"/>
                    <ComboBoxItem Content="22"/>
                    <ComboBoxItem Content="23"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="26"/>
                    <ComboBoxItem Content="27"/>
                    <ComboBoxItem Content="28"/>
                    <ComboBoxItem Content="29"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="31"/>
                </ComboBox>

                <ComboBox Name="MonthComboBox"
                          Margin="0,10"
                          Padding="10"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select Month" Foreground="Gray"/>
                    <ComboBoxItem Content="January"/>
                    <ComboBoxItem Content="February"/>
                    <ComboBoxItem Content="March"/>
                    <ComboBoxItem Content="April"/>
                    <ComboBoxItem Content="May"/>
                    <ComboBoxItem Content="June"/>
                    <ComboBoxItem Content="July"/>
                    <ComboBoxItem Content="August"/>
                    <ComboBoxItem Content="September"/>
                    <ComboBoxItem Content="October"/>
                    <ComboBoxItem Content="November"/>
                    <ComboBoxItem Content="December"/>
                </ComboBox>

                <ComboBox Name="YearComboBox"
                          Margin="0,10"
                          Padding="10"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select Year" Foreground="Gray"/>
                    <ComboBoxItem Content="2024"/>
                    <ComboBoxItem Content="2025"/>
                    <ComboBoxItem Content="2026"/>
                </ComboBox>

                <ComboBox Name="StartTimeComboBox"
                        Margin="0,10"
                        Padding="10"
                        FontSize="16"
                        SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select Start Time" Foreground="Gray"/>
                    <ComboBoxItem Content="08:00"/>
                    <ComboBoxItem Content="08:30"/>
                    <ComboBoxItem Content="09:00"/>
                    <ComboBoxItem Content="09:30"/>
                    <ComboBoxItem Content="10:00"/>
                    <ComboBoxItem Content="10:30"/>
                    <ComboBoxItem Content="11:00"/>
                    <ComboBoxItem Content="11:30"/>
                    <ComboBoxItem Content="12:00"/>
                    <ComboBoxItem Content="12:30"/>
                    <ComboBoxItem Content="13:00"/>
                    <ComboBoxItem Content="13:30"/>
                    <ComboBoxItem Content="14:00"/>
                    <ComboBoxItem Content="14:30"/>
                    <ComboBoxItem Content="15:00"/>
                    <ComboBoxItem Content="15:30"/>
                    <ComboBoxItem Content="16:00"/>
                    <ComboBoxItem Content="16:30"/>
                    <ComboBoxItem Content="17:00"/>
                    <ComboBoxItem Content="17:30"/>
                </ComboBox>

                <ComboBox Name="EndTimeComboBox"
                        Margin="0,10"
                        Padding="10"
                        FontSize="16"
                        SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select End Time" Foreground="Gray"/>
                    <ComboBoxItem Content="08:30"/>
                    <ComboBoxItem Content="09:00"/>
                    <ComboBoxItem Content="09:30"/>
                    <ComboBoxItem Content="10:00"/>
                    <ComboBoxItem Content="10:30"/>
                    <ComboBoxItem Content="11:00"/>
                    <ComboBoxItem Content="11:30"/>
                    <ComboBoxItem Content="12:00"/>
                    <ComboBoxItem Content="12:30"/>
                    <ComboBoxItem Content="13:00"/>
                    <ComboBoxItem Content="13:30"/>
                    <ComboBoxItem Content="14:00"/>
                    <ComboBoxItem Content="14:30"/>
                    <ComboBoxItem Content="15:00"/>
                    <ComboBoxItem Content="15:30"/>
                    <ComboBoxItem Content="16:00"/>
                    <ComboBoxItem Content="16:30"/>
                    <ComboBoxItem Content="17:00"/>
                    <ComboBoxItem Content="17:30"/>
                    <ComboBoxItem Content="18:00"/>
                </ComboBox>

                <ComboBox Name="PeopleAmountComboBox"
                          Margin="0,10"
                          Padding="10"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem IsEnabled="False" IsSelected="True" Content="Select Amount of People" Foreground="Gray"/>
                    
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="13"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="17"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="19"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="21"/>
                    <ComboBoxItem Content="22"/>
                    <ComboBoxItem Content="23"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="25"/>
                </ComboBox>


                <Button Name="ConfirmButton"
                        Content="Find Available Rooms"
                        Margin="0,20,0,0"
                        Padding="10"
                        FontSize="16"
                        Background="#007ACC"
                        Foreground="White"
                        Click="ConfirmButton_Click"/>

                <TextBlock Text="Available Rooms (Click to Book)"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,20,0,10"
                           TextAlignment="Center"/>

                <ListView Name="AvailableRoomsListView"
          Height="150"
          BorderBrush="#007ACC"
          BorderThickness="1"
          Background="White"
          SelectionChanged="AvailableRoomsListBox_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="{Binding StatusBackground}"/>
                    
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                               Text="{Binding DisplayText}" 
                               FontSize="14"
                               FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Capacity: " FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Capacity}"/>
                                        <TextBlock Text="{Binding StatusText}" 
                                   Foreground="{Binding StatusForeground}"
                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>

            <TextBlock Text="Spacefinder"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,20"/>
        </Grid>
    </Grid>
</Page>