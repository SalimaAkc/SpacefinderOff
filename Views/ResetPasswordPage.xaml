<Page x:Class="SpacefinderOff.Views.ResetPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ResetPassword">

    <Grid Background="#F8F9FA">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="15"
                Padding="40"
                MinWidth="400">

            <StackPanel>
                <TextBlock Text="🔒"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Reset your password"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"
                           Margin="0,0,0,20"/>

                <TextBlock Text="New Password"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"/>
                <PasswordBox x:Name="NewPasswordBox"
                             Margin="0,0,0,15"
                             Padding="10"
                             FontSize="14"/>

                <TextBlock Text="Confirm Password"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Margin="0,0,0,20"
                             Padding="10"
                             FontSize="14"/>

                <Button Content="Reset Password"
                        Padding="0,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#28A745"
                        Foreground="White"
                        Click="ResetPasswordButton_Click"/>

                <Button Content="Back to login"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#007ACC"
                        FontWeight="Bold"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        Click="BackToLoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
