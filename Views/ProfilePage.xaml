<Page x:Class="SpacefinderOff.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Profile">
    
    <Grid>
        <Button Content="← Back to Bookings"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="20"
        Padding="12,6"
        FontSize="14"
        FontWeight="SemiBold"
        Background="#EFF6FF"  
        Foreground="#1D4ED8"
        BorderBrush="#93C5FD"
        BorderThickness="1"
        Cursor="Hand"
        Click="BackToBookingsButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DBEAFE"/>
                           
                            <Setter Property="BorderBrush" Value="#60A5FA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            </Button>


            <ScrollViewer Margin="0,60,0,0" VerticalScrollBarVisibility="Auto">

            <Grid Background="#F8F9FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Margin="20"
                    Padding="30">
                <StackPanel HorizontalAlignment="Center">

                    <Border Width="120"
                            Height="120"
                            CornerRadius="60"
                            Background="#E5E7EB"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,15">
                        <Image Name="ProfileImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>
                    </Border>

                    <Button Name="UploadPhotoButton"
                            Content="Upload New Photo"
                            Background="#FF4757"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,8"
                            Margin="0,0,0,20"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="UploadPhotoButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF3742"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Name="UserNameLabel"
                               Text="Salima Akachar"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#2E3440"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Name ="StatusName"
                               Text="Student"
                               FontSize="14"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                        
                        <TextBlock Name="RegistrationDateTextBlock"
                                FontSize="12"
                                Foreground="#6B7280"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10"/>


                        <Button Name="LogoutButton"
                            Content="Log Out"
                            Background="#3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,8"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Width="180"
                            Click="LogoutButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>


                    <Button Name="DeleteAccountButton"
                            Content="Delete Account"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,8"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Width="180"
                            Click="DeleteAccountButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B91C1C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="10"
                            Margin="0,20,20,20"
                            Padding="30">
                <StackPanel>
                    <TextBlock Text="Profile"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2E3440"
                               Margin="0,0,0,30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Full Name" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <TextBox Name="FullNameLabel"
                                     Padding="12"
                                     BorderBrush="#D1D5DB"
                                     Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <TextBox Name="UsernameLabel"
                                     Padding="12"
                                     BorderBrush="#D1D5DB"
                                     Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Current Password" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <PasswordBox Name="CurrentPasswordBox"
                                         Padding="12"
                                         BorderBrush="#D1D5DB"
                                         Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Study Program" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <ComboBox Name="StudyProgramComboBox"
                                    Padding="10"
                                    BorderBrush="#D1D5DB"
                                    Background="White"
                                    SelectedIndex="0">
                                <ComboBoxItem Content="Data Science, Protection &amp; Security" />
                                <ComboBoxItem Content="Application Development" />
                                <ComboBoxItem Content="Network &amp; Cyber Security" />
                                <ComboBoxItem Content="AI &amp; Robotics" />
                                <ComboBoxItem Content="Multimedia &amp; Creative Technology" />
                                <ComboBoxItem Content="Business IT" />
                            </ComboBox>
                        </StackPanel>



                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="New Password" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <PasswordBox Name="NewPasswordBox"
                                         Padding="12"
                                         BorderBrush="#D1D5DB"
                                         Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Confirm New Password" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <PasswordBox Name="ConfirmNewPasswordBox"
                                         Padding="12"
                                         BorderBrush="#D1D5DB"
                                         Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <TextBox Name="EmailTextBox"
                                     Padding="12"
                                     BorderBrush="#D1D5DB"
                                     Background="#F9FAFB"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Language" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <ComboBox Name="LanguageCombobox">
                                <ComboBoxItem Content="English" IsSelected="True"/>
                                <ComboBoxItem Content="Dutch"/>
                                <ComboBoxItem Content="French"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Name="RecentBookings"
                               Text="Recent Bookings"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2E3440"
                               Margin="0,30,0,15"/>

                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="5">
                        <ListView Name="BookingsListView"
                                  Height="150"
                                  Background="White">
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Room A101" FontWeight="SemiBold" Width="100"/>
                                    <TextBlock Text="2024-01-15" Width="100"/>
                                    <TextBlock Text="14:00 - 16:00" Width="120"/>
                                    <TextBlock Text="Confirmed" Foreground="Green"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Room B205" FontWeight="SemiBold" Width="100"/>
                                    <TextBlock Text="2024-01-12" Width="100"/>
                                    <TextBlock Text="10:00 - 12:00" Width="120"/>
                                    <TextBlock Text="Completed" Foreground="Blue"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Lab C301" FontWeight="SemiBold" Width="100"/>
                                    <TextBlock Text="2024-01-10" Width="100"/>
                                    <TextBlock Text="09:00 - 11:00" Width="120"/>
                                    <TextBlock Text="Completed" Foreground="Blue"/>
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Button Name="UpdateInfoButton"
                                Content="Update Info"
                                Background="#FF4757"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="25,12"
                                Margin="0,0,15,0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="UpdateInfoButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF3742"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                            <Button Name="ChangePasswordButton"
                                    Content="Change Password"
                                    Background="#3B82F6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="25,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="ChangePasswordButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
