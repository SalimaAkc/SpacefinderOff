<Page x:Class="SpacefinderOff.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Home" Height="320" Width="535">

    <Grid Background="White" Margin="-30,0,29,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="471">
            <TextBlock Text="Welcome to Spacefinder"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#2E3440"
                       HorizontalAlignment="Center"
                       Margin="30,30,30,50"/>

            <Button Content="Find your perfect workspace"
                       Name ="FindYourSpace"
                       FontSize="16"
                       Foreground="#4C566A"
                       HorizontalAlignment="Center" Click="FindYourSpace_Click"/>
        </StackPanel>
    </Grid>
</Page>