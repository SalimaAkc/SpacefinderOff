<Page x:Class="SpacefinderOff.Views.CodeVerificationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EnterCode">

    <Grid Background="#F8F9FA">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="15" Padding="40" MinWidth="400">

            <StackPanel>
                <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Enter your 4-digit code"
                           FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="#2C3E50" Margin="0,0,0,5"/>

                <TextBox Name="CodeTextBox" MaxLength="4" FontSize="18"
                         HorizontalAlignment="Center" Padding="15"
                         Margin="0,30,0,20" Width="200" TextAlignment="Center"/>

                <Button Content="Verify"
                        Name="VerifyButton"
                        Click="VerifyButton_Click"
                        Padding="10" FontSize="16"
                        Background="#007ACC"
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
